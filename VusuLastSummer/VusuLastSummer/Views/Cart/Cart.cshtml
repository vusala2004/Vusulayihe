@using VusuLastSummer.ViewModels
@using VusuLastSummer.ViewModels.Cart
@model CartIndexVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<section class="section">
    <div class="container">
        <h1 class="text-center">Shopping Cart</h1>

        <div id="cart-content">
            @if (!Model.CartItems.Any())
            {
                <div class="text-center">
                    <h2>Your cart is empty</h2>
                    <p>Add some delicious items from our menu!</p>
                    <a href="/Menu" class="btn">Browse Menu</a>
                </div>
            }
            else
            {
                <div class="grid grid-1" style="gap: 1rem;">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="card">
                            <div class="card-content">
                                <div class="flex gap-2 align-center">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/default-product.jpg" : item.ImageUrl)" alt="@item.ProductName" style="width: 80px; height: 80px; object-fit: cover; border-radius: 5px;">

                                    <div style="flex: 1;">
                                        <h3>@item.ProductName</h3>
                                        <p>Size: @item.Size</p>
                                        <p>Price: $@item.Price.ToString("0.00")</p>
                                    </div>

                                    <div class="flex align-center gap-1">
                                        <button class="btn btn-secondary qty-btn">-</button>
                                        <span>@item.Quantity</span>
                                        <button class="btn btn-secondary qty-btn">+</button>
                                    </div>

                                    <div>
                                        <p><strong>$@item.Total.ToString("0.00")</strong></p>
                                        <button class="btn btn-secondary remove-btn" style="margin-top: 0.5rem;">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.CartItems.Any())
        {
            <div id="order-summary">
                <div class="card" style="max-width: 400px; margin: 2rem auto;">
                    <div class="card-content">
                        <h3>Order Summary</h3>
                        <p>Subtotal: $@Model.Subtotal.ToString("0.00")</p>
                        <p>Delivery Fee: $@Model.DeliveryFee.ToString("0.00")</p>
                        <p><strong>Total: $@Model.TotalAmount.ToString("0.00")</strong></p>
                        <a href="/Checkout" class="btn btn-full">Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // İrəlidə Database qoşulanda + və - düymələrini basdıqda səhifə
        // yenilənmədən (AJAX vasitəsilə) sayları artırıb-azaltmaq üçün
        // xüsusi funksiyaları bura yazacağıq. Hələlik sadəcə vizual olaraq işləyir.
    </script>
}

