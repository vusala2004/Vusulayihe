@using VusuLastSummer.ViewModels
@using VusuLastSummer.ViewModels.Cart
@model CartIndexVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<section class="section">
    <div class="container">
        <h1 class="text-center" style="margin-bottom: 2rem;">Shopping Cart</h1>

        <div id="cart-content">
            @if (!Model.CartItems.Any())
            {
                <div class="text-center" style="padding: 4rem 0;">
                    <h2>Your cart is empty</h2>
                    <p>Add some delicious items from our menu!</p>
                    <a href="/Menu" class="btn" style="margin-top: 1rem;">Browse Menu</a>
                </div>
            }
            else
            {
                <div class="grid grid-1" style="gap: 1.5rem; max-width: 800px; margin: 0 auto;">

                    @* BURA DƏYİŞDİ: Yeni dizaynlı səbət məhsulları *@
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="cart-item-card" style="display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">

                            <div style="display: flex; align-items: center; gap: 1.5rem;">
                                <img src="~/img/@(string.IsNullOrEmpty(item.ImageUrl) ? "default-product.jpg" : item.ImageUrl)"
                                     alt="@item.ProductName"
                                     style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid var(--sand);">

                                <div>
                                    <h3 style="margin: 0 0 0.5rem 0; font-size: 1.4rem; color: #333;">@item.ProductName</h3>
                                    <p style="margin: 0 0 0.3rem 0; color: #666; font-size: 0.95rem;">Size: <strong>@item.Size</strong></p>
                                    <p style="margin: 0; color: #888; font-size: 0.9rem;">Unit Price: $@item.Price.ToString("0.00")</p>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 3rem;">

                                <div style="display: flex; align-items: center; border: 1px solid #ddd; border-radius: 6px; overflow: hidden; background: #fafafa;">
                                    <button class="btn-secondary qty-btn" style="border: none; background: transparent; padding: 0.5rem 1rem; cursor: pointer; font-size: 1.2rem;">-</button>
                                    <span style="padding: 0 1rem; font-weight: bold; color: #333;">@item.Quantity</span>
                                    <button class="btn-secondary qty-btn" style="border: none; background: transparent; padding: 0.5rem 1rem; cursor: pointer; font-size: 1.2rem;">+</button>
                                </div>

                                <div style="text-align: right; min-width: 90px;">
                                    <h4 style="margin: 0 0 0.5rem 0; font-size: 1.3rem; color: var(--gold);">
                                        $@item.Total.ToString("0.00")
                                    </h4>

                                    <a href="/Cart/Remove?productId=@item.ProductId&size=@item.Size"
                                       style="color: #d9534f; text-decoration: none; font-size: 0.9rem; border-bottom: 1px solid #d9534f; transition: 0.3s; cursor: pointer;">
                                        Remove
                                    </a>
                                </div>

                            </div>
                        </div>
                    }
                    @* YENİ DİZAYN BURADA BİTİR *@

                </div>
            }
        </div>

        @if (Model.CartItems.Any())
        {
            <div id="order-summary">
                <div class="card" style="max-width: 400px; margin: 2rem auto; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.08);">
                    <div class="card-content" style="padding: 2rem;">
                        <h3 style="margin-bottom: 1.5rem; text-align: center;">Order Summary</h3>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; color: #555;">
                            <span>Subtotal:</span>
                            <span>$@Model.Subtotal.ToString("0.00")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; color: #555; border-bottom: 1px solid #eee; padding-bottom: 1.5rem;">
                            <span>Delivery Fee:</span>
                            <span>$@Model.DeliveryFee.ToString("0.00")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 2rem; font-size: 1.2rem;">
                            <strong>Total:</strong>
                            <strong style="color: var(--gold);">$@Model.TotalAmount.ToString("0.00")</strong>
                        </div>

                        <a href="/Checkout" class="btn btn-full" style="width: 100%; display: block; text-align: center;">Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // Hələlik yalnız vizual məntiq
    </script>
}

