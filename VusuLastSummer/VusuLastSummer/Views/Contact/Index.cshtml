@using VusuLastSummer.ViewModels
@using VusuLastSummer.ViewModels.ContactVM
@model ContactVM
@{
    ViewData["Title"] = "Contact Us - Last Summer";
}

<section class="section">
    <div class="container">
        <h1 class="text-center">Contact Us</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 5px; margin-bottom: 2rem; text-align: center; font-weight: bold;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="grid grid-2 gap-3">
            <div>
                <div class="card">
                    <div class="card-content">
                        <h3>Send us a message</h3>

                        <form asp-controller="Contact" asp-action="Index" method="post" id="contact-form">
                            <div class="form-group">
                                <label asp-for="Name">Name *</label>
                                <input asp-for="Name" required>
                            </div>

                            <div class="form-group">
                                <label asp-for="Email">Email *</label>
                                <input asp-for="Email" required>
                            </div>

                            <div class="form-group">
                                <label asp-for="Subject">Subject *</label>
                                <input asp-for="Subject" required>
                            </div>

                            <div class="form-group">
                                <label asp-for="Message">Message *</label>
                                <textarea asp-for="Message" rows="5" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-full">Send Message</button>
                        </form>

                    </div>
                </div>
            </div>

            <div>
                <div class="card mb-3">
                    <div class="card-content">
                        <h3>Get in Touch</h3>
                        <div class="grid grid-2 gap-2">
                            <div class="text-center">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem;">📍</div>
                                <h4>Address</h4>
                                <p>123 Coffee Street<br>Bean City, BC 12345</p>
                            </div>
                            <div class="text-center">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem;">📞</div>
                                <h4>Phone</h4>
                                <p>(555) 123-4567</p>
                            </div>
                            <div class="text-center">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem;">✉️</div>
                                <h4>Email</h4>
                                <p>hello@brule.com</p>
                            </div>
                            <div class="text-center">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🕒</div>
                                <h4>Hours</h4>
                                <p>Mon-Fri: 7AM-8PM<br>Sat-Sun: 8AM-9PM</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-content">
                        <h3>Find Us</h3>
                        <div style="width: 100%; height: 250px; background: var(--sand); border-radius: 10px; display: flex; align-items: center; justify-content: center; position: relative;">
                            <div style="font-size: 3rem;">🗺️</div>
                            <div style="position: absolute; bottom: 10px; left: 10px; background: rgba(255,255,255,0.9); padding: 0.5rem; border-radius: 5px;">
                                123 Coffee Street, Bean City
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-content text-center">
                        <h3>Follow Us</h3>
                        <div class="social-icons">
                            <a href="#" aria-label="Facebook">📘</a>
                            <a href="#" aria-label="Instagram">📷</a>
                            <a href="#" aria-label="Twitter">🐦</a>
                            <a href="#" aria-label="LinkedIn">💼</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>