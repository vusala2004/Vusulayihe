@using Microsoft.AspNetCore.Identity
@using VusuLastSummer.DAL
@using VusuLastSummer.Models
@using Microsoft.EntityFrameworkCore
@inject UserManager<AppUser> UserManager
@inject AppDbContext Context

@{
    int basketCount = 0;
    if (User.Identity.IsAuthenticated)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            // İstifadəçinin səbətindəki bütün məhsulların sayını (Quantity) cəmləyirik
            basketCount = await Context.BasketItems
                .Where(bi => bi.Basket.AppUserId == user.Id)
                .SumAsync(bi => (int?)bi.Quantity) ?? 0;
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Last Summer</title>

    <link rel="stylesheet" href="~/css/style.css">

    @RenderSection("Styles", required: false)
</head>
<body>

    <nav class="navbar" id="navbar">
        <div class="navbar-container">
            <a asp-controller="Home" asp-action="Index" class="logo">Last Summer 🐦‍⬛</a>

            <ul class="nav-links" id="nav-links">
                <li><a asp-controller="Home" asp-action="Index" data-key="home">Home</a></li>
                <li><a asp-controller="Menu" asp-action="Menu" data-key="menu">Menu</a></li>
                <li><a asp-controller="About" asp-action="Index" data-key="about">About</a></li>
                <li><a asp-controller="Blog" asp-action="Index" data-key="blog">Blog</a></li>
                <li><a asp-controller="Contact" asp-action="Contact" data-key="contact">Contact</a></li>
                <li><a asp-controller="Reservation" asp-action="Reservation" data-key="reservations">Reservations</a></li>
            </ul>

            <div class="flex gap-2 align-center">

                @* Səbət İkonu və Dinamik Sayğac *@
                <a asp-controller="Basket" asp-action="Index" class="cart-icon" style="text-decoration: none; position: relative;">
                    🛒
                    @if (basketCount > 0)
                    {
                        <span class="cart-badge" id="cart-badge" style="background: red; color: white; border-radius: 50%; padding: 2px 6px; font-size: 12px; position: absolute; top: -5px; right: -10px;">
                            @basketCount
                        </span>
                    }
                </a>

                <div class="user-icon" onclick="toggleUserMenu()" style="cursor: pointer;">👤</div>

                <div class="hamburger" id="hamburger" onclick="toggleMobileMenu()">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

            </div>
        </div>

        <div id="user-menu" class="hidden"
             style="position: absolute; top: 100%; right: 20px; background: var(--cream); padding: 1rem; border-radius: 5px; box-shadow: 0 4px 15px var(--shadow);">
            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Profile">Profile (@User.Identity.Name)</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    <button type="submit" style="background:none; border:none; color:inherit; cursor:pointer; padding:0; font:inherit;">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </div>
    </nav>

    <main class="main">
        @RenderBody()
    </main>

    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="~/js/footer.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/products.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>