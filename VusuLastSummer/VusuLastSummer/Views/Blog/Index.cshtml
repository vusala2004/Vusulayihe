@model VusuLastSummer.ViewModels.Blog.BlogIndexVM
@{
    ViewData["Title"] = "Coffee Blog";
}

<section class="section">
    <div class="container">
        <h1 class="text-center">Coffee Blog</h1>

        <div class="flex justify-center gap-2 mb-3">
            <button class="btn btn-secondary blog-category active" data-category="All">All</button>
            <button class="btn btn-secondary blog-category" data-category="Brewing Tips">Brewing Tips</button>
            <button class="btn btn-secondary blog-category" data-category="Recipes">Recipes</button>
            <button class="btn btn-secondary blog-category" data-category="News">News</button>
        </div>
        <div class="grid grid-3" id="blog-grid">

            @if (Model == null || Model.Posts == null || !Model.Posts.Any())
            {
                <p class="text-center" style="grid-column: span 3;">Hələlik heç bir bloq yazısı yoxdur.</p>
            }
            else
            {
                @foreach (var post in Model.Posts)
                {
                    <div class="card blog-card fade-in" data-category="@post.BlogCategory?.Name" style="background-color: #f6f3eb; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; height: 100%; border: none;">

                        <div style="width: 100%; height: 250px; overflow: hidden;">
                            <img src="/img/@(string.IsNullOrEmpty(post.ImageUrl) ? "default-blog.jpg" : post.ImageUrl)"
                                 alt="@post.Title"
                                 style="width: 100%; height: 100%; object-fit: cover;">
                        </div>

                        <div class="card-content" style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div style="background-color: #d1bfae; color: #4a3b32; padding: 4px 12px; border-radius: 20px; display: inline-block; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; margin-bottom: 12px;">
                                    @post.BlogCategory?.Name
                                </div>

                                <h3 style="font-family: 'Playfair Display', serif; color: #3e2723; margin-bottom: 10px; font-size: 1.4rem; line-height: 1.2;">
                                    @post.Title
                                </h3>

                                <p style="color: #6d6d6d; font-size: 0.9rem; line-height: 1.5; margin-bottom: 15px;">
                                    @(string.IsNullOrEmpty(post.Excerpt)
                                                                ? (post.Content?.Length > 120 ? Html.Raw(post.Content.Substring(0, 120) + "...") : Html.Raw(post.Content))
                                                                : post.Excerpt)
                        </p>
                    </div>

                            <div style="border-top: 1px solid #eee; pt-3; display: flex; flex-direction: column; gap: 10px; padding-top: 15px;">
                                <span style="color: #8c8c8c; font-size: 0.8rem;">@post.PublishedAt.ToString("dd/MM/yyyy")</span>
                                <a href="/Blog/@post.Slug" class="btn" style="background-color: #c4a98b; color: #fff; text-align: center; border-radius: 5px; padding: 8px; text-decoration: none; font-weight: bold;">
                                    Read More
                                </a>
                            </div>
                        </div>
                    </div>
                        }
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Category filter məntiqi
            const categoryBtns = document.querySelectorAll('.blog-category');
            const blogCards = document.querySelectorAll('.blog-card');

            categoryBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    // Aktiv classını dəyişdir
                    categoryBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const selectedCategory = this.dataset.category;

                    // Postları göstər/gizlət (Səhifə yenilənmədən)
                    blogCards.forEach(card => {
                        if (selectedCategory === 'All' || card.dataset.category === selectedCategory) {
                            card.style.display = 'block'; // Göstər
                            // Animasiya effekti vermək üçün
                            card.classList.remove('fade-in');
                            void card.offsetWidth; // reflow trigger
                            card.classList.add('fade-in');
                        } else {
                            card.style.display = 'none'; // Gizlət
                        }
                    });
                });
            });
        });
    </script>
}