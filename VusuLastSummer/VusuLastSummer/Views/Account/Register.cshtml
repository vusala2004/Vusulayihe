@using VusuLastSummer.ViewModels.Account
@model RegisterVM
<!-- Begin Main Content Area -->
<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh;">
    <div style="width: 100%; max-width: 450px; padding: 20px;">
        <h2 style="text-align: center; font-family: serif; color: #3e2723; margin-bottom: 30px;">Register</h2>

        <form method="post">
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: #3e2723;">Username</label>
                <input type="text" name="Username" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: #3e2723;">Email Address</label>
                <input type="email" name="Email" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: #3e2723;">Password</label>
                <input type="password" name="Password" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" />
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; margin-bottom: 5px; color: #3e2723;">Confirm Password</label>
                <input type="password" name="ConfirmPassword" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" />
            </div>

            <button type="submit" style="width: 100%; padding: 10px; background-color: #c09e7a; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px;">
                Register
            </button>

            <div style="margin-top: 15px; text-align: center;">
                <a href="/Account/Login" style="color: #c09e7a; text-decoration: none; font-size: 14px;">Already have an account? Login here</a>
            </div>
        </form>
    </div>
</div>