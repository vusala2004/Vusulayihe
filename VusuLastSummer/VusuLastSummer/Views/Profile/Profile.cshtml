@using VusuLastSummer.ViewModels
@using VusuLastSummer.ViewModels.Profile
@model ProfileVM
@{
    ViewData["Title"] = "My Profile - Last Summer";
}

<section class="section">
    <div class="container">
        <h1 class="text-center">My Profile</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 5px; margin-bottom: 2rem; text-align: center; font-weight: bold;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="grid grid-2 gap-3">
            <div>
                <div class="card">
                    <div class="card-content text-center">
                        <div style="width: 100px; height: 100px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 2rem; color: var(--espresso); margin: 0 auto 1rem;">
                            <span>@Model.Initials</span>
                        </div>
                        <h3>@Model.Name</h3>
                        <p>@Model.Email</p>

                        <div class="mt-3">
                            <h4>Loyalty Points</h4>
                            <p style="font-size: 2rem; color: var(--gold); font-weight: bold;">@Model.LoyaltyPoints</p>
                            <p>Points earned from orders</p>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-content">
                        <h3>Edit Profile</h3>
                        <form asp-controller="Profile" asp-action="Index" method="post">
                            <div class="form-group">
                                <label asp-for="Name">Name</label>
                                <input asp-for="Name" required>
                            </div>
                            <div class="form-group">
                                <label asp-for="Email">Email</label>
                                <input asp-for="Email" type="email" required>
                            </div>
                            <div class="form-group">
                                <label asp-for="Phone">Phone</label>
                                <input asp-for="Phone">
                            </div>
                            <div class="form-group">
                                <label asp-for="Birthday">Birthday</label>
                                <input asp-for="Birthday" type="date">
                            </div>
                            <button type="submit" class="btn btn-full">Save Changes</button>
                        </form>
                    </div>
                </div>
            </div>

            <div>
                <div class="card mb-3">
                    <div class="card-content">
                        <h3>Order History</h3>
                        <p>View your past orders</p>
                    </div>
                </div>

                <div id="order-history">
                    @if (!Model.Orders.Any())
                    {
                        <p class="text-center">You haven't placed any orders yet.</p>
                    }
                    else
                    {
                        @foreach (var order in Model.Orders)
                        {
                            <div class="card mb-2">
                                <div class="card-content">
                                    <div class="flex justify-between">
                                        <div>
                                            <h4>Order #@order.OrderNumber</h4>
                                            <p>@order.Timestamp.ToString("dd MMM yyyy")</p>
                                            <p>Status: @order.Status</p>
                                        </div>
                                        <div class="text-right">
                                            <p><strong>$@order.Total.ToString("0.00")</strong></p>
                                            <p>@order.ItemCount items</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</section>