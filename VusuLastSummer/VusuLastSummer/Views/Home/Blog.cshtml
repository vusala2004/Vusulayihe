@{
    ViewData["Title"] = "About";
    ViewData["Page"] = "about";
}

<!-- ── HERO ── -->
<section data-section="hero">
    <div data-role="hero-content">
        <h1 data-key="hero-title">Our Story</h1>
        <p data-key="hero-subtitle">Crafting exceptional coffee experiences since 2021</p>
    </div>
</section>

<!-- ── TIMELINE ── -->
<section data-section="timeline">
    <div class="container">
        <h2>Our Journey</h2>
        <div data-role="timeline">

            <div data-role="timeline-item">
                <div data-role="timeline-dot"></div>
                <div data-role="timeline-content">
                    <h3>2021 – The Beginning</h3>
                    <p>
                        Like every great story, ours began with a dream. Last Summer Coffee was founded out of
                        a deep passion for coffee — just like the heroes of Son Yaz, we stepped onto a path
                        that would change everything.
                    </p>
                </div>
            </div>

            <div data-role="timeline-item">
                <div data-role="timeline-dot"></div>
                <div data-role="timeline-content">
                    <h3>2024 – First Location</h3>
                    <p>
                        When our first café opened, people didn't just come for coffee — they came to share
                        feelings, memories, and stories. Like Akgün taking his first steps toward a new life,
                        we opened the door to a new beginning.
                    </p>
                </div>
            </div>

            <div data-role="timeline-item">
                <div data-role="timeline-dot"></div>
                <div data-role="timeline-content">
                    <h3>2025 – Expansion</h3>
                    <p>
                        Despite challenges, we expanded and introduced online ordering. Our commitment to
                        quality and sustainability earned recognition across the industry.
                    </p>
                </div>
            </div>

            <div data-role="timeline-item">
                <div data-role="timeline-dot"></div>
                <div data-role="timeline-content">
                    <h3>2026 – Today</h3>
                    <p>
                        Today, Last Summer Coffee serves thousands of customers daily with carefully sourced
                        beans, expertly crafted beverages, and warm hospitality. We're just getting started!
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ── TEAM ── -->
<section data-section="team">
    <div class="container">
        <h2>Meet Our Team</h2>
        <div data-layout="grid-4">

            <div class="card" data-role="team-card">
                <img src="~/img/Akgun.jpg" alt="Sarah Johnson">
                <div class="card-content">
                    <h3>Sarah Johnson</h3>
                    <p data-role="team-role">Head Barista</p>
                    <p>Like Akgün, Sarah started from nothing and built herself through passion. Every cup she makes tells a story worth telling.</p>
                </div>
            </div>

            <div class="card" data-role="team-card">
                <img src="~/img/Selim.jpg" alt="Mike Chen">
                <div class="card-content">
                    <h3>Mike Chen</h3>
                    <p data-role="team-role">Roaster</p>
                    <p>Much like Selim, Mike is a man of principle. He travels the world for the finest beans — quality is a responsibility.</p>
                </div>
            </div>

            <div class="card" data-role="team-card">
                <img src="~/img/indir (12).jpg" alt="Emma Davis">
                <div class="card-content">
                    <h3>Emma Davis</h3>
                    <p data-role="team-role">Operations Manager</p>
                    <p>Strong and unshakeable — just like Yağmur. Emma ensures every customer leaves with a smile.</p>
                </div>
            </div>

            <div class="card" data-role="team-card">
                <img src="~/img/Canan.jpg" alt="James Wilson">
                <div class="card-content">
                    <h3>James Wilson</h3>
                    <p data-role="team-role">Customer Experience</p>
                    <p>Like the warm heart of Son Yaz, James believes every person deserves to feel seen and valued.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ── VALUES ── -->
<section data-section="values">
    <div class="container">
        <h2>Our Values</h2>
        <div data-layout="grid-3">
            <div data-role="value-card">
                <span data-role="value-icon">☕</span>
                <h3>Quality</h3>
                <p>We never compromise on the quality of our beans, brewing methods, or customer service.</p>
            </div>
            <div data-role="value-card">
                <span data-role="value-icon">🌱</span>
                <h3>Sustainability</h3>
                <p>Committed to ethical sourcing, eco-friendly practices, and supporting our local community.</p>
            </div>
            <div data-role="value-card">
                <span data-role="value-icon">🤝</span>
                <h3>Community</h3>
                <p>Coffee brings people together. We're proud to be a gathering place for our community.</p>
            </div>
        </div>
    </div>
</section>

<!-- ── VIDEO PROMO ── -->
<section data-section="video-promo">
    <div class="container">
        <h2>Experience Last Summer</h2>
        <p>Take a virtual tour of our café and roasting facility</p>
        <div data-role="video-placeholder" onclick="showToast('Video coming soon!', 'info')">
            <div data-role="play-button">▶</div>
            <div data-role="video-label">Behind the Scenes at Last Summer Coffee</div>
        </div>
    </div>
</section>

