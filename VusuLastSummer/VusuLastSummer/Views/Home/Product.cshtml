@{
    ViewData["Title"] = "Product";
    ViewData["Page"] = "product";
}

<section data-section="product-detail">
    <div class="container">
        <div data-layout="grid-2" id="product-details"></div>
    </div>
</section>

<section data-section="related-products">
    <div class="container">
        <h2>Related Products</h2>
        <div data-layout="grid-3" id="related-products"></div>
    </div>
</section>

@section Scripts {
    <script>
        const urlParams     = new URLSearchParams(window.location.search);
        let currentProduct  = null, currentSize = 'M', currentQuantity = 1;
        const sizePrices    = { S: -0.5, M: 0, L: 0.5 };

        function getCurrentPrice() { return currentProduct.price + sizePrices[currentSize]; }

        function renderProduct() {
          document.getElementById('product-details').innerHTML = `
            <div data-role="product-image">
              <img src="${currentProduct.image}" alt="${currentProduct.name}">
            </div>
            <div data-role="product-info">
              <h1>${currentProduct.name}</h1>
              <p data-role="product-desc">${currentProduct.description}</p>
              <div data-role="size-selector">
                <label>Size:</label>
                <div data-role="size-buttons">
                  <button class="btn btn-secondary size-btn ${currentSize==='S'?'active':''}" data-size="S">Small</button>
                  <button class="btn btn-secondary size-btn ${currentSize==='M'?'active':''}" data-size="M">Medium</button>
                  <button class="btn btn-secondary size-btn ${currentSize==='L'?'active':''}" data-size="L">Large</button>
                </div>
              </div>
              <div data-role="qty-selector">
                <label>Quantity:</label>
                <div data-role="qty-controls">
                  <button class="btn btn-secondary" id="qty-minus">−</button>
                  <span id="quantity-display">${currentQuantity}</span>
                  <button class="btn btn-secondary" id="qty-plus">+</button>
                </div>
              </div>
              <p data-role="product-price-wrap">Price: <strong id="product-price">$${getCurrentPrice().toFixed(2)}</strong></p>
              <button class="btn btn-full" id="add-to-cart-btn">Add to Cart</button>
            </div>`;

          document.querySelectorAll('.size-btn').forEach(btn => {
            btn.addEventListener('click', function () {
              document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
              this.classList.add('active');
              currentSize = this.dataset.size;
              document.getElementById('product-price').textContent = '$' + getCurrentPrice().toFixed(2);
            });
          });
          document.getElementById('qty-minus').addEventListener('click', () => {
            if (currentQuantity > 1) { currentQuantity--; document.getElementById('quantity-display').textContent = currentQuantity; }
          });
          document.getElementById('qty-plus').addEventListener('click', () => {
            currentQuantity++; document.getElementById('quantity-display').textContent = currentQuantity;
          });
          document.getElementById('add-to-cart-btn').addEventListener('click', () => {
            addItem(currentProduct.id, currentQuantity, currentSize);
            updateCartBadge();
            showToast('Added to cart!', 'success');
          });
        }

        function renderRelatedProducts() {
          const related = products.filter(p => p.category === currentProduct.category && p.id !== currentProduct.id).slice(0, 3);
          document.getElementById('related-products').innerHTML = related.map(p => `
            <div class="card" data-product-id="${p.id}">
              <img src="${p.image}" alt="${p.name}">
              <div class="card-content">
                <h3>${p.name}</h3>
                <p>${p.description}</p>
                <p data-role="product-price"><strong>$${p.price.toFixed(2)}</strong></p>
                <a href="/Home/Product?id=${p.id}" class="btn btn-full">View Details</a>
              </div>
            </div>`).join('');
        }

        document.addEventListener('DOMContentLoaded', function () {
          currentProduct = getProductById(urlParams.get('id'));
          if (!currentProduct) { window.location.href = '/Home/Menu'; return; }
          renderProduct();
          renderRelatedProducts();
        });
    </script>
}

