@{
    ViewData["Title"] = "Checkout";
    ViewData["Page"] = "checkout";
}

<section data-section="checkout">
    <div class="container">
        <h1 data-key="page-title">Checkout</h1>
        <div data-layout="grid-2">

            <form id="checkout-form" data-role="checkout-form">
                <div data-role="form-group"><label for="full-name">Full Name *</label><input type="text" id="full-name" required></div>
                <div data-role="form-group"><label for="email">Email *</label><input type="email" id="email" required></div>
                <div data-role="form-group"><label for="phone">Phone *</label><input type="tel" id="phone" required></div>
                <div data-role="form-group">
                    <label>Delivery Method</label>
                    <div data-role="delivery-toggle-group">
                        <button type="button" class="btn btn-secondary delivery-toggle active" data-method="pickup">Pickup</button>
                        <button type="button" class="btn btn-secondary delivery-toggle" data-method="delivery">Delivery</button>
                    </div>
                </div>
                <div id="address-fields" data-role="address-fields" class="hidden">
                    <div data-role="form-group"><label for="address">Address *</label><input type="text" id="address" placeholder="Street address"></div>
                    <div data-role="form-group"><label for="city">City *</label><input type="text" id="city"></div>
                    <div data-role="form-group"><label for="zip">ZIP *</label><input type="text" id="zip"></div>
                </div>
                <button type="submit" class="btn btn-full">Continue to Payment</button>
            </form>

            <div class="card" data-role="summary-card">
                <div class="card-content">
                    <h3>Order Summary</h3>
                    <div id="order-items"></div>
                    <hr data-role="divider">
                    <p>Subtotal: $<span id="subtotal">0.00</span></p>
                    <p>Delivery Fee: $<span id="delivery-fee">0.00</span></p>
                    <p><strong>Total: $<span id="total">0.00</span></strong></p>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        let deliveryMethod = 'pickup';
        document.querySelectorAll('.delivery-toggle').forEach(btn => {
          btn.addEventListener('click', function () {
            document.querySelectorAll('.delivery-toggle').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            deliveryMethod = this.dataset.method;
            document.getElementById('address-fields').classList.toggle('hidden', deliveryMethod !== 'delivery');
            document.getElementById('delivery-fee').textContent = deliveryMethod === 'delivery' ? '3.00' : '0.00';
            updateTotal();
          });
        });
        function updateTotal() {
          const sub = getTotal(), fee = deliveryMethod === 'delivery' ? 3 : 0;
          document.getElementById('subtotal').textContent = sub.toFixed(2);
          document.getElementById('total').textContent    = (sub + fee).toFixed(2);
        }
        function renderOrderSummary() {
          document.getElementById('order-items').innerHTML = getCart().map(item => `
            <div data-role="summary-line">
              <span>${item.name} (${item.size}) x${item.quantity}</span>
              <span>$${(item.price * item.quantity).toFixed(2)}</span>
            </div>`).join('');
          updateTotal();
        }
        document.getElementById('checkout-form').addEventListener('submit', function (e) {
          e.preventDefault();
          let valid = true;
          this.querySelectorAll('input[required]').forEach(f => {
            const ok = !!f.value.trim();
            f.closest('[data-role="form-group"]').classList.toggle('error', !ok);
            if (!ok) valid = false;
          });
          if (!valid) { showToast('Please fill in all required fields', 'error'); return; }
          localStorage.setItem('brule_checkout', JSON.stringify({
            fullName: document.getElementById('full-name').value, email: document.getElementById('email').value,
            phone: document.getElementById('phone').value, deliveryMethod,
            address: deliveryMethod === 'delivery' ? document.getElementById('address').value : '',
            city: deliveryMethod === 'delivery' ? document.getElementById('city').value : '',
            zip: deliveryMethod === 'delivery' ? document.getElementById('zip').value : '',
            cart: getCart(), subtotal: getTotal(), deliveryFee: deliveryMethod === 'delivery' ? 3 : 0,
            total: getTotal() + (deliveryMethod === 'delivery' ? 3 : 0)
          }));
          window.location.href = '/Home/Payment';
        });
        document.addEventListener('DOMContentLoaded', function () {
          if (!getCart().length) { window.location.href = '/Home/Cart'; return; }
          renderOrderSummary();
        });
    </script>
}

