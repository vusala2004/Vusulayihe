@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Admin layout-unu seçirik
}

<section id="dashboard" class="admin-section active">
    <h1>Admin Panel - Brûlé Coffee</h1>
    <p>Xoş gəlmisiniz! Burada sifarişləri, məhsulları, istifadəçiləri və rezervasyonları idarə edə bilərsiniz.</p>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Orders</h3>
            <p id="total-orders">120</p>
        </div>
        <div class="stat-card">
            <h3>Revenue</h3>
            <p id="total-revenue">$4,500.00</p>
        </div>
        <div class="stat-card">
            <h3>Active Users</h3>
            <p id="active-users">45</p>
        </div>
        <div class="stat-card">
            <h3>Today's Reservations</h3>
            <p id="today-reservations">8</p>
        </div>
    </div>
</section>
