<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/admin.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <h2>Admin Panel</h2>
            <nav>
                <a href="/Admin/Dashboard" class="sidebar-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Dashboard" ? "active" : "")">Dashboard</a>
                <a href="/Admin/Products" class="sidebar-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Products" ? "active" : "")">Products</a>
                <a href="/Admin/Orders" class="sidebar-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Orders" ? "active" : "")">Orders</a>
                <a href="/Admin/Users" class="sidebar-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Users" ? "active" : "")">Users</a>
                <a href="/Admin/Reservations" class="sidebar-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Reservations" ? "active" : "")">Reservations</a>
                <a href="/Admin/Blog" class="sidebar-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Blog" ? "active" : "")">Blog</a>
            </nav>
            <a href="/" class="btn btn-secondary" style="margin-top: auto;">Back to Site</a>
        </aside>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/toast.js"></script>
    <script src="~/js/main.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
