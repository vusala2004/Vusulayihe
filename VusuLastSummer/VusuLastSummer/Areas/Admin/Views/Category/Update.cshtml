@model VusuLastSummer.Areas.Admin.ViewModels.Categories.CategoryUpdateVM
@{
    ViewData["Title"] = "Kateqoriyanı Yenilə";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid p-4">
    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Kateqoriyanı Yenilə</h4>
        </div>
        <div class="card-body">
            <form asp-action="Update" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

               

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Kateqoriya Adı</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger fw-bold"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Yenilə</button>
                    <a asp-action="Index" class="btn btn-secondary">İmtina Et</a>
                </div>
            </form>
        </div>
    </div>
</div>