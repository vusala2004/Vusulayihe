@model List<Category>
@{
    ViewData["Title"] = "Kateqoriyalar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Kateqoriyalar</h2>
        <a asp-action="Create" class="btn btn-success">+ Yeni Kateqoriya</a>
    </div>

    <table class="table table-striped table-hover align-middle border text-center">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Kateqoriya Adı</th>
                <th>Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int count = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@count</td>
                        <td class="fw-bold">@item.Name</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Ətraflı</a>
                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Yenilə</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bu kateqoriyanı silməyə əminsiniz?');">Sil</a>
                        </td>
                    </tr>
                    count++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted p-4">Hələ heç bir kateqoriya əlavə edilməyib.</td>
                </tr>
            }
        </tbody>
    </table>
</div>