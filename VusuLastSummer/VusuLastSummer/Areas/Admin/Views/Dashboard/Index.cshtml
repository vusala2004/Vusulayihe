@model VusuLastSummer.Areas.Admin.ViewModels.Dashboard.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section id="dashboard" class="admin-section active">
    <h1>Admin Panel - Last Summer Coffee</h1>
    <p>Xoş gəlmisiniz! Burada sifarişləri, məhsulları, istifadəçiləri və rezervasyonları idarə edə bilərsiniz.</p>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Orders</h3>
            <p id="total-orders">@Model.TotalOrders</p>
        </div>
        <div class="stat-card">
            <h3>Revenue</h3>
            <p id="total-revenue">@Model.TotalEarnings.ToString("C2")</p>
        </div>
        <div class="stat-card">
            <h3>Active Users</h3>
            <p id="active-users">@Model.ActiveUsers</p>
        </div>
        <div class="stat-card">
            <h3>Today's Reservations</h3>
            <p id="today-reservations">@Model.PendingReservations</p>
        </div>
    </div>
</section>