@using VusuLastSummer.Areas.Admin.ViewModels.Products
@model List<GetProductVM>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Məhsullar</h2>
        <a asp-action="Create" class="btn btn-success">Yeni Məhsul Əlavə Et</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Şəkil</th>
                <th>Ad</th>
                <th>Kateqoriya</th>
                <th>Qiymət</th>
                <th>Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="~/img/@item.ImageURL" alt="@item.Name" style="width: 80px; height: 80px; object-fit: cover;" />
                    </td>
                    <td class="align-middle">@item.Name</td>
                    <td class="align-middle">@item.CategoryName</td>
                    <td class="align-middle">@item.Price.ToString("C")</td>
                    <td class="align-middle">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Bax</a>
                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Yenilə</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Silmək istədiyinizə əminsiniz?');">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>