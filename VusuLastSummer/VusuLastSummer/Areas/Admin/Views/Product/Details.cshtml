@model Product

<div class="container mt-4">
    <h2>Məhsul Detalları</h2>
    <hr />

    <div class="card">
        <div class="row g-0">
            <div class="col-md-4">
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <img src="~/assets/images/products/@Model.ProductImages.FirstOrDefault().ImageURL" class="img-fluid rounded-start" alt="@Model.Name" style="height: 100%; object-fit: cover;">
                }
                else
                {
                    <img src="~/assets/images/no-image.jpg" class="img-fluid rounded-start" alt="No Image">
                }
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h3 class="card-title">@Model.Name</h3>
                    <h4 class="text-success mb-3">@Model.Price.ToString("C")</h4>

                    <p class="card-text"><strong>Təsvir:</strong> @Model.Description</p>
                  
                    <p class="card-text"><strong>Kateqoriya:</strong> @Model.Category?.Name</p>

                    

                    <div class="mt-4">
                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">Yenilə</a>
                        <a asp-action="Index" class="btn btn-secondary">Siyahıya Qayıt</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
