@using VusuLastSummer.Areas.Admin.ViewModels.Products
@model UpdateProductVM

<div class="container mt-4">
    <h2>Məhsulu Yenilə</h2>
    <hr />

    <form asp-action="Update" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Məhsulun Adı</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Qiymət</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                   
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Melumat</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Cari Şəkil</label>

                    <div class="mb-2">
                        @if (Model.ProductImages != null && Model.ProductImages.Any())
                        {
                            var image = Model.ProductImages.FirstOrDefault();

                            <img src="@Url.Content("~/img/" + image.ImageURL)"
                                 alt="Product Image"
                                 style="width: 30%; height: 500px; object-fit: cover; border-radius: 8px; border:1px solid #ddd;" />
                        }
                        else
                        {
                            <img src="~/img/no-image.png"
                                 alt="No Image"
                                 style="width: 30%; height: 500px; object-fit: cover; border-radius: 8px; border:1px solid #ddd;" />
                        }
                    </div>

                    <label asp-for="Photo" class="form-label">
                        Yeni Şəkil Yüklə (Dəyişmək istəyirsinizsə)
                    </label>

                    <input asp-for="Photo" type="file" class="form-control" accept="image/*" />

                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Kateqoriya</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                        <option value="">-- Kateqoriya Seçin --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

              

                <button type="submit" class="btn btn-warning w-100">Yadda Saxla</button>
                <a asp-action="Index" class="btn btn-secondary w-100 mt-2">Geri Qayıt</a>
            </div>
        </div>
    </form>
</div>

