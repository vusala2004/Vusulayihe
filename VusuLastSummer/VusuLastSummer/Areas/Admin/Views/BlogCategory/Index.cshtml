@model IEnumerable<VusuLastSummer.Models.BlogCategory>
@{
    ViewData["Title"] = "Bloq Kateqoriyaları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Bloq Kateqoriyaları</h2>
        <a asp-action="Create" class="btn btn-primary">Yeni Kateqoriya Yarat</a>
    </div>

    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Kateqoriya Adı</th>
                <th>Slug (Link)</th>
                <th>Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(count++)</td>
                    <td>@item.Name</td>
                    <td>@item.Slug</td>
                    <td>
                        <a href="#" class="btn btn-sm btn-warning">Düzəliş Et</a>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?');">
                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>