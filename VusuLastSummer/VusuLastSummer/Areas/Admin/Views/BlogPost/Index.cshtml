@model IEnumerable<VusuLastSummer.Models.BlogPost>
@{
    ViewData["Title"] = "Məqalələr";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 1;
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Bloq Məqalələri</h2>
        <a asp-action="Create" class="btn btn-primary">Yeni Məqalə Yarat</a>
    </div>

    <table class="table table-bordered table-striped shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Şəkil</th>
                <th>Başlıq</th>
                <th>Kateqoriya</th>
                <th>Status</th>
                <th>Tarix</th>
                <th>Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(count++)</td>
                    <td>
                        <img src="~/img/blog/@item.ImageUrl" alt="Blog Image" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px;" />
                    </td>
                    <td>@item.Title</td>
                    <td>@item.BlogCategory.Name</td>
                    <td>
                        @if (item.IsPublished)
                        {
                            <span class="badge bg-success">Paylaşılıb</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Qaralama</span>
                        }
                    </td>
                    <td>@item.PublishedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <a href="#" class="btn btn-sm btn-warning">Düzəliş Et</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?');">
                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
